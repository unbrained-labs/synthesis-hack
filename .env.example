# AgentClear — Environment Variables
# Copy this file to .env and fill in your values.

# Synthesis Hackathon
SYNTHESIS_API_KEY=sk-synth-...

# Coinbase Developer Platform (https://portal.cdp.coinbase.com)
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Wallets — generated by: npm run wallets (in packages/scripts)
BUYER_PRIVATE_KEY=
BUYER_WALLET_ADDRESS=
SELLER_PRIVATE_KEY=
SELLER_WALLET_ADDRESS=

# Blackbox DKG nodes (theblackbox.network)
DKG_NODE_1=https://theblackbox.network/node1
DKG_NODE_2=https://theblackbox.network/node2
DKG_NODE_3=https://theblackbox.network/node3
DKG_NODE_4=https://theblackbox.network/node4
DKG_NODE_5=https://theblackbox.network/node5

# Demo settings
SELLER_URL=http://localhost:4022
WALLET_PASSWORD=agentclear-demo-2026
