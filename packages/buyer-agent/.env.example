# Coinbase CDP credentials
CDP_API_KEY_ID=
CDP_API_KEY_SECRET=

# Blackbox DKG nodes
DKG_NODE_1=https://theblackbox.network/node1
DKG_NODE_2=https://theblackbox.network/node2
DKG_NODE_3=https://theblackbox.network/node3
DKG_NODE_4=https://theblackbox.network/node4
DKG_NODE_5=https://theblackbox.network/node5

# Seller agent endpoint
SELLER_URL=http://localhost:4022

# Cross-chain routing (optional — defaults to base_sepolia for both)
# SOURCE_CHAIN: chain where buyer deposits (e.g. polygon-amoy, sepolia, bnb-testnet, solana-devnet)
# TARGET_CHAIN: chain where seller receives payment (must match seller's chain)
# Example: SOURCE_CHAIN=polygon-amoy TARGET_CHAIN=base_sepolia
SOURCE_CHAIN=base_sepolia
TARGET_CHAIN=base_sepolia

# Wallet encryption password used by Blackbox MCP
WALLET_PASSWORD=agentclear-demo-2026

# OpenServ platform API key — get from platform.openserv.ai > Developer > Your Agents > Create Secret Key
OPENSERV_API_KEY=
