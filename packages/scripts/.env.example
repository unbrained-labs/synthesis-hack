# ============================================================
# AgentClear Scripts — Environment Variables
# Copy to ../../.env (repo root) or set here for local use
# ============================================================

# Coinbase Developer Platform (CDP) credentials
# Get from: https://portal.cdp.coinbase.com/
CDP_API_KEY_ID=your-cdp-api-key-id
CDP_API_KEY_SECRET=your-cdp-api-key-secret

# Wallet addresses (populated by setup-wallets.ts)
BUYER_WALLET_ADDRESS=
SELLER_WALLET_ADDRESS=

# Private key for ERC-8004 registration (hex, with 0x prefix)
# Export from CDP or generate a dedicated key
REGISTRATION_PRIVATE_KEY=0x...

# Optional: override RPC
BASE_SEPOLIA_RPC_URL=https://sepolia.base.org
